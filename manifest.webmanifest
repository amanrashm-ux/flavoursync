{
  "name": "FlavourSync.in",
  "short_name": "FlavourSync",
  "description": "Classic Indian meals, scheduled orders and bulk food enquiries for Danapur and nearby Patna.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#141719",
  "theme_color": "#141719",
  "categories": ["food", "shopping", "business"],
  "lang": "en-IN",
  "icons": [
    {
      "src": "assets/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Order Menu",
      "short_name": "Menu",
      "description": "Open the FlavourSync order menu.",
      "url": "./menu.html",
      "icons": [{ "src": "assets/pwa-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Schedule Order",
      "short_name": "Schedule",
      "description": "Send a scheduled meal request.",
      "url": "./schedule.html",
      "icons": [{ "src": "assets/pwa-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
