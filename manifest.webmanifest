{
  "name": "FlavourSync.in",
  "short_name": "FlavourSync",
  "description": "Juicy non-veg meals, scheduled orders, kebab boxes, biryani and party trays from FlavourSync.",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#090706",
  "theme_color": "#090706",
  "categories": ["food", "shopping", "business"],
  "lang": "en-IN",
  "icons": [
    {
      "src": "assets/pwa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/pwa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/pwa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Juicy Menu",
      "short_name": "Menu",
      "description": "Open FlavourSync mutton, chicken, biryani and kebab items.",
      "url": "./menu.html",
      "icons": [{ "src": "assets/pwa-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Schedule Order",
      "short_name": "Schedule",
      "description": "Send a scheduled meal request.",
      "url": "./schedule.html",
      "icons": [{ "src": "assets/pwa-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Party Packs",
      "short_name": "Bulk",
      "description": "Open FlavourSync bulk tray and party order details.",
      "url": "./catering.html",
      "icons": [{ "src": "assets/pwa-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
